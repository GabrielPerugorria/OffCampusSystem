# EvoTech Events API — copie este arquivo para .env e preencha os valores.
# Nunca versione o arquivo .env com credenciais reais.

NODE_ENV=development
PORT=3333

# Banco de dados MySQL. Use o host do seu provedor se o banco for remoto.
DB_HOST=localhost
DB_PORT=3306
DB_USER=evotech
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=evotech_events
DB_CONNECTION_LIMIT=10

# Alternativa: configure DATABASE_URL em vez de DB_HOST/DB_PORT/DB_USER/
# DB_PASSWORD/DB_NAME. Comente as linhas DB_* acima ao usar DATABASE_URL,
# pois valores DB_* definidos têm prioridade sobre a URL.
# DATABASE_URL=mysql://usuario:senha@host:3306/banco

# Para bancos que exigem TLS, configure DB_SSL=true e DB_SSL_CA.
# DB_SSL=true
# DB_SSL_CA=src/certs/ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=gere_um_segredo_aleatorio
JWT_EXPIRES_IN=15m
REFRESH_SECRET=gere_outro_segredo_aleatorio
REFRESH_EXPIRES_DAYS=30
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
AUTO_CONFIRM_ORDERS=true
