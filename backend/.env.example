# ============================================================
#  EvoTech Events API — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env.
# ============================================================

# Servidor
NODE_ENV=development
PORT=3333

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=evotech
DB_PASSWORD=
DB_NAME=evotech_events
DB_CONNECTION_LIMIT=10

# Autenticação (gere com: openssl rand -hex 64)
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_SECRET=
REFRESH_EXPIRES_DAYS=30
BCRYPT_ROUNDS=12

# CORS — origens permitidas, separadas por vírgula.
# Dev:  http://localhost:5500,http://127.0.0.1:5500
# Prod: https://SEU-USUARIO.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Pedidos: em dev, confirma o pagamento automaticamente e emite o ingresso na hora.
# Em produção, deixe false e confirme via gateway/webhook.
AUTO_CONFIRM_ORDERS=true
